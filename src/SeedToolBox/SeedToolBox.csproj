<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- WinForms is only used for the tray icon -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeedToolBox.Core\SeedToolBox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\pinyin.bin" />
  </ItemGroup>

  <!-- Native DLLs built from /native are copied to Native\x64 and Native\x86 next to the exe -->
  <ItemGroup>
    <None Include="..\..\native\bin\x64\*.dll" Link="Native\x64\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\native\bin\x86\*.dll" Link="Native\x86\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- PaddleOCR (PP-OCRv4) models go to Ocr, the ONNX Runtime that runs them to Native\x64 and Native\x86 -->
  <ItemGroup>
    <None Include="Assets\Ocr\*" Link="Ocr\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\onnxruntime.dll" Link="Native\x64\onnxruntime.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x86\native\onnxruntime.dll" Link="Native\x86\onnxruntime.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" ExcludeAssets="native;build;buildTransitive" GeneratePathProperty="true" />
    <PackageReference Include="nQuant" Version="1.0.3" />
    <PackageReference Include="NUglify" Version="1.23.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

</Project>

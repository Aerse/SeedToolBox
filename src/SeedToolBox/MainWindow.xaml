<Window x:Class="SeedToolBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SeedToolBox" Width="420" Height="600" MinWidth="300" MinHeight="320"
        WindowStyle="None" Background="{StaticResource WindowBrush}" FontSize="13"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        PreviewDragOver="OnPreviewDragOver" DragLeave="OnWindowDragLeave"
        PreviewTextInput="OnPreviewTextInput"
        Closing="OnClosing" KeyDown="OnKeyDown">

    <!-- The 1px glass edge makes Windows draw its shadow (and round the corners on Windows 11) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ContextMenu x:Key="TileMenu" x:Shared="False">
            <MenuItem Header="打开" FontWeight="SemiBold" Click="OnItemOpen" />
            <MenuItem Header="以管理员身份运行" Click="OnItemRunAsAdmin" />
            <MenuItem Header="打开文件位置" Click="OnItemOpenLocation" />
            <Separator />
            <MenuItem Header="重命名" Click="OnItemRename" />
            <MenuItem Header="删除" Click="OnItemDelete" />
            <Separator />
            <MenuItem Header="属性..." Click="OnItemProperties" />
        </ContextMenu>

        <!-- Shared by the three item views -->
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
            <Setter Property="ContextMenu" Value="{StaticResource TileMenu}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTileMouseDown" />
            <EventSetter Event="MouseMove" Handler="OnTileMouseMove" />
            <EventSetter Event="MouseLeftButtonUp" Handler="OnItemClick" />
            <EventSetter Event="DragOver" Handler="OnTileDragOver" />
            <EventSetter Event="Drop" Handler="OnTileDrop" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
                <!-- Pressed: shrink a little -->
                <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="0:0:0.08" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="0:0:0.08" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                    <Setter Property="Opacity" Value="0.35" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="LargeTileTemplate">
            <Border Style="{StaticResource TileStyle}" Width="76" Height="84">
                <StackPanel Margin="2,10,2,0">
                    <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                               TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="32" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SmallTileTemplate">
            <Border Style="{StaticResource TileStyle}" Width="124" Height="32">
                <DockPanel Margin="8,0">
                    <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ListTileTemplate">
            <Border Style="{StaticResource TileStyle}" Height="44">
                <DockPanel Margin="10,0">
                    <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontSize="11"
                                   Foreground="{StaticResource HintTextBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="StackPanelTemplate">
            <StackPanel />
        </ItemsPanelTemplate>

        <!-- Picks the template and panel for the selected group's view -->
        <Style x:Key="GroupItemsStyle" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource LargeTileTemplate}" />
            <Setter Property="ItemsPanel" Value="{StaticResource WrapPanelTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem.View, ElementName=GroupList}" Value="Small">
                    <Setter Property="ItemTemplate" Value="{StaticResource SmallTileTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedItem.View, ElementName=GroupList}" Value="List">
                    <Setter Property="ItemTemplate" Value="{StaticResource ListTileTemplate}" />
                    <Setter Property="ItemsPanel" Value="{StaticResource StackPanelTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Group tabs: accent underline under the selected one -->
        <Style x:Key="GroupTabStyle" TargetType="ListBoxItem">
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnGroupMouseDown" />
            <EventSetter Event="DragOver" Handler="OnGroupDragOver" />
            <EventSetter Event="DragLeave" Handler="OnGroupDragLeave" />
            <EventSetter Event="Drop" Handler="OnGroupDrop" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,0" Height="32" Margin="0,0,2,0">
                            <Grid>
                                <ContentPresenter x:Name="Text" VerticalAlignment="Center" Margin="0,0,0,2" />
                                <Border x:Name="Underline" Height="3" Width="16" CornerRadius="1.5" VerticalAlignment="Bottom"
                                        Background="{StaticResource AccentBrush}" Visibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <DockPanel Margin="14,0,6,0">
            <Button DockPanel.Dock="Right" Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="OnCloseClick"
                    ToolTip="隐藏到托盘" AutomationProperties.Name="隐藏到托盘" WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="&#xE713;" Style="{StaticResource IconButton}"
                    Margin="0,0,2,0" ToolTip="设置" AutomationProperties.Name="设置" Click="OnSettingsClick" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button.ContextMenu>
                    <ContextMenu x:Name="SettingsMenu" Placement="Bottom" Opened="OnSettingsMenuOpened">
                        <MenuItem x:Name="LockSizeItem" Header="锁定窗体尺寸" IsCheckable="True" Click="OnLockSizeClick" />
                        <MenuItem x:Name="AutoStartItem" Header="开机自启" IsCheckable="True" Click="OnAutoStartClick" />
                        <MenuItem Header="热键设置..." Click="OnHotkeysClick" />
                        <Separator />
                        <MenuItem Header="备份数据..." Click="OnBackupClick" />
                        <MenuItem Header="恢复数据..." Click="OnRestoreClick" />
                        <MenuItem Header="打开本程序位置" Click="OnAppLocationClick" />
                        <Separator />
                        <MenuItem Header="退出" Click="OnExitClick" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Image Source="/Assets/app.ico" Width="18" Height="18" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="SeedToolBox" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
        </DockPanel>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="12,0,12,6" Height="34">
            <TextBox x:Name="SearchBox" Style="{StaticResource FluentTextBox}" Padding="30,0,8,0"
                     TextChanged="OnSearchTextChanged" PreviewKeyDown="OnSearchKeyDown" />
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource HintTextBrush}"
                       VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
            <TextBlock x:Name="SearchPlaceholder" Text="搜索（支持拼音首字母）" Foreground="{StaticResource HintTextBrush}"
                       VerticalAlignment="Center" Margin="33,0,0,0" IsHitTestVisible="False" />
        </Grid>

        <!-- Group tabs and view switch -->
        <DockPanel Grid.Row="2" Margin="10,0,12,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <RadioButton x:Name="LargeViewButton" Content="&#xECA5;" Style="{StaticResource ToggleIconButton}" ToolTip="大图标" AutomationProperties.Name="大图标"
                             Tag="Large" Checked="OnViewChecked" />
                <RadioButton x:Name="SmallViewButton" Content="&#xE8A9;" Style="{StaticResource ToggleIconButton}" ToolTip="小图标" AutomationProperties.Name="小图标"
                             Tag="Small" Checked="OnViewChecked" />
                <RadioButton x:Name="ListViewButton" Content="&#xEA37;" Style="{StaticResource ToggleIconButton}" ToolTip="列表" AutomationProperties.Name="列表"
                             Tag="List" Checked="OnViewChecked" />
            </StackPanel>
            <ListBox x:Name="GroupList" ItemsSource="{Binding Groups}" DisplayMemberPath="Name"
                     ItemContainerStyle="{StaticResource GroupTabStyle}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     PreviewMouseMove="OnGroupMouseMove" PreviewMouseWheel="OnGroupMouseWheel">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="GroupScroller" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <ItemsPresenter />
                                <Button Content="&#xE710;" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                                        ToolTip="新建分组" AutomationProperties.Name="新建分组" Click="OnAddGroup" />
                            </StackPanel>
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="新建分组" Click="OnAddGroup" />
                        <MenuItem Header="重命名分组" Click="OnRenameGroup" />
                        <Separator />
                        <MenuItem Header="删除分组" Click="OnDeleteGroup" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </DockPanel>

        <!-- Items -->
        <Border Grid.Row="3" Margin="12,0,12,0" CornerRadius="8"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4" FocusVisualStyle="{x:Null}">
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="添加程序/文件..." Click="OnAddFile" />
                        <MenuItem Header="添加网址..." Click="OnAddUrl" />
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
                <Grid Background="Transparent">
                    <ItemsControl x:Name="GroupItems" ItemsSource="{Binding SelectedItem.Items, ElementName=GroupList}"
                                  Style="{StaticResource GroupItemsStyle}" Margin="4,0" />
                    <ItemsControl x:Name="SearchResults" ItemTemplate="{StaticResource LargeTileTemplate}" Margin="4,0"
                                  Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding Visibility, ElementName=EmptyHint}" VerticalAlignment="Top"
                                Margin="0,90,0,0" IsHitTestVisible="False">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="36"
                                   Foreground="#C8C8C8" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock x:Name="EmptyHint" Text="把程序、快捷方式、文件夹或网址&#x0a;拖到这里即可添加"
                                   Foreground="{StaticResource HintTextBrush}" TextAlignment="Center" LineHeight="20"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Tools -->
        <ItemsControl x:Name="Tools" Grid.Row="4" Margin="10,6,10,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ToolButtonStyle}" Click="OnToolClick">
                        <StackPanel>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>

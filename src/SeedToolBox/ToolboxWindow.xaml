<Window x:Class="SeedToolBox.ToolboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SeedToolBox 工具箱" Width="1000" Height="680" MinWidth="560" MinHeight="400"
        WindowStyle="None" Background="{StaticResource WindowBrush}" FontSize="13"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title bar -->
        <DockPanel Grid.ColumnSpan="2" Margin="14,0,6,0">
            <Button DockPanel.Dock="Right" Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="OnCloseClick"
                    ToolTip="关闭" AutomationProperties.Name="关闭" WindowChrome.IsHitTestVisibleInChrome="True" />
            <Image Source="/Assets/app.ico" Width="18" Height="18" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="工具箱" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
        </DockPanel>

        <!-- Sidebar -->
        <DockPanel x:Name="NavPanel" Grid.Row="1" Width="200">
            <Button x:Name="CollapseButton" DockPanel.Dock="Bottom" Style="{StaticResource IconButton}" HorizontalAlignment="Left"
                    Margin="12,4,0,10" Click="OnCollapseClick" />
            <ListBox x:Name="FooterList" DockPanel.Dock="Bottom" ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                     Margin="8,4,8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnNavSelectionChanged" />
            <Border DockPanel.Dock="Bottom" Height="1" Margin="12,2,12,2" Background="{StaticResource CardBorderBrush}" />
            <ListBox x:Name="NavList" ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                     Margin="8,0,8,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnNavSelectionChanged" />
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>
                <!-- Screen tools -->
                <DockPanel x:Name="ToolsView" Margin="24,20,24,20" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="屏幕工具" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="点击后窗口会先隐藏，再开始截取屏幕；也可以直接用右上角的快捷键" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <ItemsControl x:Name="Tools">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ToolButtonStyle}" Click="OnToolClick">
                                    <Border Width="170" Height="96" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                                            Background="Transparent" Padding="14,12">
                                        <Grid>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="22"
                                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Hotkey}" FontSize="11" Foreground="{StaticResource HintTextBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Label}" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- Other pages, created on first visit -->
                <ContentControl x:Name="PageHost" Margin="24,20,24,20" Focusable="False" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
